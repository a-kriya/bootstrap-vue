{
  "name": "bootstrap-vue",
  "version": "2.23.1",
  "description": "With more than 85 components, over 45 available plugins, several directives, and 1000+ icons, BootstrapVue provides one of the most comprehensive implementations of the Bootstrap v4 component and grid system available for Vue.js v2.6, complete with extensive and automated WAI-ARIA accessibility markup.",
  "main": "./dist/bootstrap-vue.common.js",
  "web": "./dist/bootstrap-vue.js",
  "module": "./esm/index.js",
  "jsnext:main": "./esm/index.js",
  "source": "./src/index.js",
  "sass": "./src/index.scss",
  "style": "./dist/bootstrap-vue.css",
  "license": "MIT",
  "repository": "bootstrap-vue/bootstrap-vue",
  "homepage": "https://bootstrap-vue.org",
  "types": "./src/index.d.ts",
  "web-types": "./dist/web-types.json",
  "vetur": {
    "tags": "./dist/vetur-tags.json",
    "attributes": "./dist/vetur-attributes.json"
  },
  "files": [
    "dist",
    "esm",
    "nuxt",
    "src"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "**/*.vue",
    "./docs",
    "./types"
  ],
  "scripts": {
    "build": "scripts/build.sh",
    "lint": "eslint --ext .js,.md,.vue ./",
    "prepare": "husky && patch-package && npm run build",
    "pretty": "prettier --write '**/*.{js,json,md,scss,ts,vue}'",
    "release": "npm run pretty && npm run test && npm run build && npm run release-notes && standard-version",
    "release-notes": "jiti ./scripts/release-notes",
    "test": "npm run test:unit",
    "test:unit": "jest",
    "watch": "rollup -c scripts/rollup.config.js --watch"
  },
  "lint-staged": {
    "*{.js,.md,.vue}": "eslint --ext",
    "**/*.{js,json,md,scss,ts,vue}": "prettier --write"
  },
  "dependencies": {
    "bootstrap": "^4.6.2",
    "popper.js": "^1.16.1",
    "portal-vue": "^2.1.7",
    "vue-functional-data-merge": "^3.1.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.26.4",
    "@babel/core": "^7.26.0",
    "@babel/plugin-transform-modules-commonjs": "^7.26.3",
    "@babel/plugin-transform-runtime": "^7.25.9",
    "@babel/preset-env": "^7.26.0",
    "@babel/standalone": "^7.26.4",
    "@testing-library/jest-dom": "^5.17.0",
    "@vue/compat": "^3.5.13",
    "@vue/compiler-dom": "^3.5.13",
    "@vue/compiler-sfc": "^3.5.13",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "babel-core": "^7.0.0-bridge.0",
    "babel-eslint": "^10.1.0",
    "babel-jest": "^26.6.3",
    "babel-plugin-istanbul": "^6.1.1",
    "bootstrap-icons": "^1.11.3",
    "clean-css-cli": "^5.6.3",
    "core-js": "^3.39.0",
    "cross-env": "^7.0.3",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-config-standard": "^16.0.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^24.7.0",
    "eslint-plugin-markdown": "^2.2.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-promise": "^5.2.0",
    "eslint-plugin-vue": "^7.20.0",
    "execa": "^5.1.1",
    "husky": "^9.1.7",
    "jest": "^26.6.3",
    "jiti": "^2.4.2",
    "lint-staged": "^11.2.6",
    "loader-utils": "^2.0.4",
    "lodash": "^4.17.21",
    "patch-package": "^8.0.0",
    "postcss": "^8.4.49",
    "postcss-cli": "^8.3.1",
    "prettier": "^2.8.8",
    "require-context": "^1.1.0",
    "rollup": "^2.79.2",
    "rollup-plugin-babel": "^4.4.0",
    "rollup-plugin-commonjs": "^10.1.0",
    "rollup-plugin-node-resolve": "^5.2.0",
    "sass": "1.77.6",
    "standard-version": "^9.5.0",
    "terser": "^5.37.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue-test-utils-compat": "0.0.15"
  },
  "contributors": [
    {
      "name": "Kriya",
      "url": "https://github.com/a-kriya"
    }
  ],
  "overrides": {
    "portal-vue": {
      "vue": "$vue"
    }
  }
}
